{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/cinebot", "destination": "/pages/cinebot.html" },
    { "source": "/filmsozluk", "destination": "/pages/filmsozluk.html" },
    { "source": "/filmsözlük", "destination": "/pages/filmsozluk.html" },
    { "source": "/pages/filmsözlük.html", "destination": "/pages/filmsozluk.html" },
    { "source": "/auth", "destination": "/pages/auth.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(cinebot|filmsozluk|filmsözlük|auth)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
