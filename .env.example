# ==============================================================================
# AiFlix - Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı ".env.local" olarak kopyalayıp kendi anahtarlarınızı girin.
# GERÇEK ANAHTARLARINIZI ASLA GIT REPOSUNA COMMIT ETMEYİN!
# ==============================================================================

# --- Uygulama URL (SEO, Canonical & OG için) ---
NEXT_PUBLIC_SITE_URL=https://aiflix-rho.vercel.app

# --- TMDB API (SADECE SUNUCU TARAFI - İstemciye asla gitmez) ---
# https://www.themoviedb.org/settings/api adresinden alın
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# --- Google Gemini API (SADECE SUNUCU TARAFI - CineBot AI için) ---
# https://aistudio.google.com/apikey adresinden alın
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Client Config (İstemci SDK - HTTP Referrer kısıtlaması ekleyin) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase App Check (reCAPTCHA v3 Site Key - Önerilen) ---
# Firebase Console -> App Check -> Web App -> reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Firebase Admin SDK (SADECE SUNUCU TARAFI - ID Token doğrulama için) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
