rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    // FilmSözlük başlık görselleri (max 2 MB, jpg/png/webp, sadece girişli sahibi)
    match /entries/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Kullanıcı profil avatarları (max 2 MB, jpg/png/webp, sadece girişli sahibi)
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Diğer tüm yollar kapalı
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
