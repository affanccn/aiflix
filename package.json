{
  "name": "aiflix",
  "version": "2.0.0",
  "private": true,
  "description": "AiFlix - Yapay Zeka Destekli Film Keşif ve Sinema Topluluğu Platformu",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:filmsozluk": "node scripts/migrate-filmsozluk.mjs"
  },
  "dependencies": {
    "firebase": "^11.5.0",
    "firebase-admin": "^13.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.3",
    "prettier": "^3.5.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
